{
  "name": "supdger/sandadmin",
  "type": "library",
  "description": "PostgreSQL-native administration plugins for Webman.",
  "keywords": [
    "webman",
    "admin",
    "postgresql"
  ],
  "homepage": "https://github.com/supdger/sandadmin",
  "license": "MIT",
  "authors": [
    {
      "name": "SandAdmin maintainers",
      "role": "Maintainer"
    },
    {
      "name": "SaiAdmin contributors",
      "homepage": "https://github.com/saithink/saiadmin",
      "role": "Upstream"
    }
  ],
  "support": {
    "issues": "https://github.com/supdger/sandadmin/issues",
    "source": "https://github.com/supdger/sandadmin"
  },
  "require": {
    "php": ">=8.1",
    "workerman/webman-framework": "^2.1",
    "monolog/monolog": "^2.0",
    "nelexa/zip": "^4.0",
    "godruoyi/php-snowflake": "^3.0.0",
    "guzzlehttp/guzzle": "^7.9",
    "illuminate/events": "^12.43",
    "illuminate/pagination": "^12.43",
    "openspout/openspout": "^4.0",
    "phpmailer/phpmailer": "^6.9 || ^7.0",
    "ramsey/uuid": "^4.0",
    "tinywan/jwt": "^1.11",
    "tinywan/storage": "^1.1",
    "topthink/think-orm": "^2.0.53 || ^3.0.0",
    "topthink/think-validate": "^3.0",
    "twig/twig": "^3.20",
    "vlucas/phpdotenv": "^5.6",
    "webman/cache": "^2.1",
    "webman/captcha": "^1.0",
    "webman/channel": "^2.1",
    "webman/console": "^2.1",
    "webman/database": "^2.1",
    "webman/event": "^1.0",
    "webman/redis": "^2.1",
    "webman/think-cache": "^2.1",
    "webman/think-orm": "^2.1",
    "workerman/crontab": "^1.0",
    "zoujingli/ip2region": "^2.0",
    "aliyuncs/oss-sdk-php": "^2.7",
    "smalot/pdfparser": "^2.12"
  },
  "autoload": {
    "psr-4": {
      "SandAdmin\\": "server/",
      "Saithink\\Saipackage\\": "server/compat/Saithink/Saipackage/",
      "plugin\\sandadmin\\": "server/plugin/sandadmin/",
      "plugin\\sandpackage\\": "server/plugin/sandpackage/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
