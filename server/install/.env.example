# PostgreSQL consumer connection. Copy to .env only when you explicitly want
# to run the installer; the package does not create or import a database.
DB_TYPE = pgsql
DB_HOST = localhost
DB_PORT = 5432
DB_NAME = sandadmin
DB_USER = root
DB_PASSWORD = change-me
DB_PREFIX =
DB_CHARSET = utf8

CACHE_MODE = file
REDIS_HOST = 127.0.0.1
REDIS_PORT = 6379
REDIS_PASSWORD = ''
REDIS_DB = 0
CAPTCHA_MODE = cache
FRONTEND_DIR = sandadmin-artd
SANDADMIN_SERVER_PORT = 8787
SANDADMIN_CHANNEL_PORT = 2206
