# PostgreSQL development connection. Copy to .env only when you explicitly
# want to run the installer; this repository does not create a database.
# DB_NAME, DB_USER and DB_PASSWORD have no built-in defaults: once .env exists,
# the server refuses to start if any of them is missing. Replace the
# placeholder values below with your own database name and credentials.
DB_TYPE = pgsql
DB_HOST = localhost
DB_PORT = 5432
DB_NAME = sandadmin
DB_USER = root
DB_PASSWORD = change-me
DB_PREFIX =
DB_CHARSET = utf8

CACHE_MODE = file
REDIS_HOST = 127.0.0.1
REDIS_PORT = 6379
REDIS_PASSWORD = ''
REDIS_DB = 0
CAPTCHA_MODE = cache
FRONTEND_DIR = sandadmin-artd
SANDADMIN_SERVER_PORT = 8787
SANDADMIN_CHANNEL_PORT = 2206

# 运行环境与调试。生产必须 APP_ENV=production 且 APP_DEBUG=false，否则服务拒绝启动。
APP_ENV = production
APP_DEBUG = false

# 开发模式本机一键登录开关，仅限本机开发调试。取消注释并置 1 后，
# 回环地址可 POST /core/dev-login 免口令签发 admin 令牌；其余取值视为关闭。
# 生产部署严禁开启。
# SAND_DEV_LOGIN = 1
