# PostgreSQL development connection. Copy to .env only when you explicitly
# want to run the installer; this repository does not create a database.
# DB_NAME, DB_USER and DB_PASSWORD have no built-in defaults: once .env exists,
# the server refuses to start if any of them is missing. Replace the
# placeholder values below with your own database name and credentials.
DB_TYPE = pgsql
DB_HOST = localhost
DB_PORT = 5432
DB_NAME = sandadmin
DB_USER = root
DB_PASSWORD = change-me
DB_PREFIX =
DB_CHARSET = utf8

CACHE_MODE = file
REDIS_HOST = 127.0.0.1
REDIS_PORT = 6379
REDIS_PASSWORD = ''
REDIS_DB = 0
CAPTCHA_MODE = cache
FRONTEND_DIR = sandadmin-artd
SANDADMIN_SERVER_PORT = 8787
# 完整 listen 串覆盖项（如只绑回环 http://127.0.0.1:8787）；留空按 PORT 拼 0.0.0.0
# SANDADMIN_SERVER_LISTEN =
SANDADMIN_CHANNEL_PORT = 2206

# 运行环境与调试。生产必须 APP_ENV=production 且 APP_DEBUG=false，否则服务拒绝启动。
APP_ENV = production
APP_DEBUG = false

# SAND-DEV-BEGIN
# 开发模式本机一键登录开关，仅限本机开发调试；生产部署严禁开启。
# /core/dev-login 由 sandadmin 插件提供：SANDADMIN_DEV_LOGIN_ENABLED=1 且
# SANDADMIN_DEV_LOGIN_USERNAME 指向已有管理员账号后，回环地址可免口令
# 签发令牌；非生产环境（APP_ENV 非 production）才放行。
# SAND_DEV_LOGIN=1 只放开宿主侧 1.x 契约路径
# /api/auth/dev-login 与 /api/admin/v1/auth/dev-login；其余取值视为关闭。
# SAND_DEV_LOGIN = 1
# SANDADMIN_DEV_LOGIN_ENABLED = 1
# SANDADMIN_DEV_LOGIN_USERNAME = admin

# 开发构建 MCP 端点令牌（仅本机开发）：需要检出内含 .sand-dev-build 标记，
# 且至少 16 位；端点只接受回环来源与本机 Origin。生产配置此值会被
# ProductionDebugGuard 拒绝启动。
# SAND_MCP_DEV_TOKEN = 换成随机长字符串例如 openssl rand -hex 24 的输出
# SAND-DEV-END

# 弱密码表路径，留空用内置 resource/security/weak-passwords.txt；生产缺表拒绝启动
SAND_WEAK_PASSWORD_PATH=

# A-5 本站源：v1 组写操作要求 Origin 与之精确相等（scheme://host[:port]，无尾斜杠）。
# 留空 = 未启用源校验（自定义头仍必查）；生产环境（APP_ENV=production）未配置拒绝启动。
# SAND_SITE_ORIGIN = https://admin.example.com
# v1 写操作必带的自定义请求头；SAND_CSRF_HEADER_VALUE 非空时还要求值相等
# SAND_CSRF_HEADER_NAME = X-Requested-With
# SAND_CSRF_HEADER_VALUE =
# v1 组跨域 Origin 白名单，逗号分隔、精确匹配；留空 = 仅同源
# SAND_CORS_ALLOWED_ORIGINS = https://admin.example.com,https://admin2.example.com
# SAND_CORS_MAX_AGE = 600

# N3 安全响应头覆盖项（缺省即有安全默认值，一般不需要改）
# SAND_REFERRER_POLICY = strict-origin-when-cross-origin
# SAND_HSTS_MAX_AGE = 15552000
# SAND_CSP_ENFORCE = false（true 时发强制 CSP 头；灰度期保持 false 发 Report-Only）
# SAND_CSP_API = default-src 'none'
# SAND_CSP_PAGE = default-src 'self'
# SAND_PERMISSIONS_POLICY = camera=(), microphone=(), geolocation=()

# 字段加密主密钥（N5/M11，详情见 docs/crypto-encrypted-fields.md）。
# 只从环境变量读，不落库、不进日志、不进仓库；缺失或长度不对时加密服务拒绝工作。
# 条目格式 v<序号>=<base64 编码的 32 字节>，生成：
# php -r "echo 'v1=' . base64_encode(random_bytes(32)) . PHP_EOL;"
# SAND_CRYPTO_KEY =
# 旧主密钥轮换列表，逗号分隔同格式条目，只用于解密旧 keyver 的密文
# SAND_CRYPTO_PREVIOUS_KEYS =

# 雪花发号器节点配置（三项必填，缺失或非法时启动自检拒绝启动）。
# 号段为部署分段下发的闭区间，格式 "起始-结束"，宽度至少容纳本机全部发号进程。
SAND_IDGEN_NODE_RANGE=
# 本机节点基值：各发号进程实际节点号 = 基值 + 进程槽位（web/task_worker/monitor
# /log_retention/插件进程各占一段），基值 + 发号进程总数 - 1 必须仍落在号段内。
SAND_IDGEN_NODE_ID=
# 时钟回拨拒发阈值（毫秒，正整数）：回拨小于阈值等待时钟追上，达到阈值拒发并告警。
# 推荐值 10：毫秒级的 NTP 校时抖动等待即可追上，更大回拨按时钟异常拒发。
SAND_IDGEN_MAX_CLOCK_BACKWARDS_MS=

# 统一出站 HTTP 客户端（src/Infra/Http/CurlOutboundClient）：所有对外 HTTP 调用
# 共用的超时、重试与 SSRF 白名单。三段超时单位毫秒：connect 建连、
# read 读停滞（低速判定）、total 整体；max_attempts 含首次，指数退避加抖动；
# 非幂等方法（POST/PATCH 等）默认不重试，可按请求覆盖。
# SAND_OUTBOUND_CONNECT_TIMEOUT_MS = 3000
# SAND_OUTBOUND_READ_TIMEOUT_MS = 10000
# SAND_OUTBOUND_TOTAL_TIMEOUT_MS = 15000
# SAND_OUTBOUND_MAX_ATTEMPTS = 3
# SAND_OUTBOUND_BACKOFF_BASE_MS = 200
# SAND_OUTBOUND_BACKOFF_MAX_MS = 2000
# SAND_OUTBOUND_MAX_BODY_BYTES = 10485760
# SSRF 白名单：逗号分隔，精确 host 或 *.后缀（大小写不敏感）；命中后该主机
# 解析到的内网/保留地址才放行（本地联调、插件回环服务用），公网主机不受影响。
# SAND_OUTBOUND_ALLOW_PRIVATE_HOSTS =
