parameters:
    level: max
    paths:
        - src
        - tests
        - app/controller/FileController.php
        - app/bootstrap/WeakPasswordGuard.php
        - app/bootstrap/IdGeneratorGuard.php
        - app/bootstrap/RuntimeConfigGuard.php
    # tools/ 里的门禁和发布期脚本不进 paths，但单测 require 它们的函数，需要可见符号（不做错误分析）
    scanFiles:
        - ../tools/dev-manifest.php
        - ../tools/check-dev-refs.php
        - ../tools/typephp_check.php
        - ../tools/strip-vendor-tests.php

rules:
    # 常驻进程安全（3i §8.3）：src//app/ 禁可变静态属性与 $GLOBALS，
    # 豁免只在规则内 ALLOWLIST 逐条登记；探针 app/phpstan 不进 paths，
    # 单独 analyse 它必须判红。
    - Sandadmin\PHPStan\ResidentStateRule
