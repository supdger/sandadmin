# Copy this file to .env.local (or .env) and adjust for your environment.
# All variables are optional; sensible defaults are built in.

# Base URL the API client prefixes to every request path.
# Use an absolute URL (e.g. https://api.example.com/api) when the backend
# lives on another origin, or keep the default path prefix when the SPA is
# served behind a reverse proxy that forwards /api to the backend.
# Default: /api
VITE_API_BASE_URL=/api

# Product name shown in the browser tab and the shell header.
# Default: SandAdmin
VITE_APP_NAME=SandAdmin

# Optional logo image URL shown in the shell header (empty = text only).
# Default: (empty)
VITE_APP_LOGO=

# Copyright line rendered in the footer.
# Default: © 2026 青岛沙盒创意网络科技有限公司
VITE_APP_COPYRIGHT=

# UI locale. 1.0 ships zh-CN only; the value is kept configurable so more
# locales can be added later without touching code.
# Default: zh-CN
VITE_DEFAULT_LOCALE=zh-CN

# Start the in-browser MSW mock worker so the UI runs without a backend.
# true/false — defaults to true in `vite dev`, false in production builds.
# Default: true (dev) / false (build)
VITE_ENABLE_MOCKS=
