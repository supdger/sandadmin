/.gitattributes export-ignore
/.gitignore export-ignore
/.github/ export-ignore
/CHANGELOG.md export-ignore
/README.md export-ignore
/catalog.json export-ignore
/docs/ export-ignore
# tools/ 下开发工具不进发布包；逐文件列。例外：词表合并脚本随包带出，
# 发布侧可复算 weak-passwords.txt 的来源与 sha256
/tools/naming_check.py export-ignore
/tools/naming-terms.tsv export-ignore
/tools/skill-sync.sh export-ignore
/sandadmin-artd/** text=auto eol=lf
/openspec/ export-ignore
/.agents/ export-ignore
# .sand-dev-build 不在 export-ignore：发布包剔除口径以 tools/dev-only-paths.txt
# 清单为唯一权威，导出后由 strip-dev.php 物理删除并复检，避免双重口径漂移
